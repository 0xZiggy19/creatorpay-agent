# ---------- PayPal (sandbox) ----------
# Create a REST app at https://developer.paypal.com/dashboard/applications/sandbox
# Leave these empty to run in MOCK mode (in-memory invoices, no network calls).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: defaults to the sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Safety: the app refuses non-sandbox bases unless this is true
PAYPAL_ALLOW_LIVE=false
# Optional: shown as the invoicer on invoices
PAYPAL_INVOICER_NAME=
PAYPAL_INVOICER_BUSINESS=

# ---------- AI (set ONE of these) ----------
# Option 0 (preferred when set): Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: comma-separated fallback chain (each model has its own free-tier rate limit)
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-flash-latest
# Option A: Vercel AI Gateway (any model, one key) - https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=
# Option B: OpenAI directly (or any OpenAI-compatible API via OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Optional model override. Gateway default: openai/gpt-5.4-mini · OpenAI default: gpt-5.4-mini
AI_MODEL=
# With no AI key the app uses a rule-based fallback parser so the UI still works.
